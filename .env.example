# OpenWRT-MCP Configuration
# Copy to ~/.config/openwrt-mcp/env (mode 600) and fill in your values.
# Sourced by ~/.config/openwrt-mcp/run before exec'ing the uv-tool binary.

# Required
OPENWRT_HOST=192.168.1.1
OPENWRT_SSH_KEY=/home/you/.ssh/openwrt_mcp_ed25519

# Optional
OPENWRT_PORT=22
OPENWRT_USER=root
# OPENWRT_PASSWORD=          # Not recommended – use SSH keys

# SSH settings
SSH_TIMEOUT=30

# Audit logging (keep outside the git tree)
ENABLE_AUDIT_LOGGING=true
AUDIT_LOG_FILE=/home/you/.local/state/openwrt-mcp/audit.log

# Write operations (disabled by default)
ENABLE_WRITE_OPERATIONS=false

# Server logging
LOG_LEVEL=INFO

# SSH host key verification (optional)
# Default TOFU store: ~/.config/openwrt-mcp/known_hosts
# OPENWRT_KNOWN_HOSTS=/home/you/.ssh/known_hosts
# OPENWRT_HOST_KEY_POLICY=tofu
